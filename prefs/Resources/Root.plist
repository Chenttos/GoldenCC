<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>title</key><string>CCAster</string>
<key>items</key><array>
<dict><key>cell</key><string>PSGroupCell</string><key>footerText</key><string>Bring the modern Control Center experience to iOS 16. Each major part can be disabled independently. Turning CCAster off installs no hooks at all - a complete, clean disable - and takes full effect after a respring.</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Enable CCAster</string><key>defaults</key><string>com.futur3sn0w.ccaster.preferences</string><key>key</key><string>Enabled</string><key>default</key><true/><key>PostNotification</key><string>com.futur3sn0w.ccaster/ReloadPrefs</string></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Features</string><key>footerText</key><string>Edit Mode disables every entry gesture when off without changing your saved Control Center layout.</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Quick Access Buttons</string><key>defaults</key><string>com.futur3sn0w.ccaster.preferences</string><key>key</key><string>QuickAccessButtonsEnabled</string><key>default</key><true/><key>PostNotification</key><string>com.futur3sn0w.ccaster/ReloadPrefs</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Edit Mode</string><key>defaults</key><string>com.futur3sn0w.ccaster.preferences</string><key>key</key><string>EditModeEnabled</string><key>default</key><true/><key>PostNotification</key><string>com.futur3sn0w.ccaster/ReloadPrefs</string></dict>
<dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Refined Look</string><key>defaults</key><string>com.futur3sn0w.ccaster.preferences</string><key>key</key><string>RefinedLookEnabled</string><key>default</key><true/><key>PostNotification</key><string>com.futur3sn0w.ccaster/ReloadPrefs</string></dict>
<dict><key>cell</key><string>PSGroupCell</string><key>footerText</key><string>Refined Look makes 1x1 controls circular and gives larger controls a softer continuous radius.</string></dict>
</array>
</dict></plist>
